# Sanity — public connection only. Safe to expose in the browser.
# Create a project at https://www.sanity.io/manage and replace these placeholders.
# Do not put tokens here.

NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production
SANITY_API_VERSION=2025-02-19

# Server-only Viewer token with draft read. Never NEXT_PUBLIC_. Needed for Studio draft preview.
# SANITY_API_READ_TOKEN=

# Hosted Studio preview origin. Not a secret. Defaults to https://www.hbw.works
# SANITY_STUDIO_PREVIEW_ORIGIN=https://www.hbw.works
# SANITY_STUDIO_URL=https://hbw.sanity.studio

# Server-only CMS publish → production rebuild. Never NEXT_PUBLIC_.
# SANITY_WEBHOOK_SECRET=
# VERCEL_DEPLOY_HOOK_URL=

# Public case-study source. Missing or any value other than "sanity" uses local experiences.ts.
# Each project is independent. Browse stays on catalog.ts either way.
# HBW_SCK_SOURCE=local
# HBW_SCK_SOURCE=sanity
# HBW_CLOSED_SOURCE=local
# HBW_CLOSED_SOURCE=sanity
# HBW_KOJA_SOURCE=local
# HBW_KOJA_SOURCE=sanity
# HBW_CHRIS_SOURCE=local
# HBW_CHRIS_SOURCE=sanity
# HBW_SUB3_SOURCE=local
# HBW_SUB3_SOURCE=sanity
# HBW_OBR_SOURCE=local
# HBW_OBR_SOURCE=sanity
