{
  "name": "hbw-website",
  "version": "0.1.0",
  "private": true,
  "description": "Faithful local reconstruction of the current public HBW site (hbw.works).",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "cms": "sanity dev",
    "cms:seed-sck": "sanity exec src/sanity/scripts/seed-sck.ts --with-user-token",
    "cms:seed-closed": "sanity exec src/sanity/scripts/seed-closed.ts --with-user-token",
    "cms:seed-koja": "sanity exec src/sanity/scripts/seed-koja.ts --with-user-token",
    "cms:seed-chris": "sanity exec src/sanity/scripts/seed-chris.ts --with-user-token",
    "test": "node --import tsx --test src/sanity/adapter/*.test.ts src/sanity/preview/*.test.ts src/components/home/projects/*.test.ts src/lib/*.test.ts",
    "test:sck-cms": "node --import tsx src/sanity/scripts/verify-sck-cms.ts",
    "test:closed-cms": "node --import tsx src/sanity/scripts/verify-closed-cms.ts",
    "test:koja-cms": "node --import tsx src/sanity/scripts/verify-koja-cms.ts",
    "test:chris-cms": "node --import tsx src/sanity/scripts/verify-chris-cms.ts"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@sanity/client": "^7.26.2",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sanity": "^6.12.0",
    "styled-components": "^6.5.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "ffmpeg-static": "^5.3.0",
    "tsx": "^4.23.13",
    "typescript": "^5.8.0"
  }
}
